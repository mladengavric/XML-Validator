# odobreni anonimizovani primjeri u tests/TestData/samples/). Svi ostali .xml
# fajlovi (npr. stvarne fakture u korijenu ili rezultati čišćenja *_ociscen.xml)
# se nikad ne commituju.
*.xml
*.XML
!tests/TestData/**/*.xml
