<?xml version="1.0" encoding="utf-8"?>
<!--
  Objavljivanje konzolnog alata za win-x64: jedan izvršni fajl sa ugrađenim .NET okruženjem.
  Pokretanje:  dotnet publish src/XmlValidator.Cli -p:PublishProfile=win-x64
  Rezultat:    artifacts/publish/win-x64/xmlvalidator-cli.exe (pored XmlValidator.exe)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
