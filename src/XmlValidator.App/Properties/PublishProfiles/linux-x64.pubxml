<?xml version="1.0" encoding="utf-8"?>
<!--
  Objavljivanje za linux-x64: jedan izvršni fajl sa ugrađenim .NET okruženjem (ne traži instaliran .NET).
  Pokretanje:  dotnet publish src/XmlValidator.App -p:PublishProfile=linux-x64
  Rezultat:    artifacts/publish/linux-x64/
  Napomena: Windows je primarna platforma (PLAN.md, odluka 4). Ovaj profil se gradi i sa Windowsa,
  ali program na Linuxu nije provjeren; za Linux su potrebne sistemske biblioteke ICU (libicu), fontconfig i X11.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      Nativne biblioteke (Skia, HarfBuzz, ANGLE) idu u izvršni fajl i raspakuju se pri prvom pokretanju.
      Sklopovi su komprimovani (manji fajl, neznatno sporije prvo pokretanje).
      Bez trimovanja: AvaloniaEdit, DataGrid i XAML učitavanje nisu pouzdani pri trimovanju.
      Simboli su ugrađeni u sklopove (Directory.Build.props), a .pdb fajlovi nativnih paketa se ne objavljuju (.csproj).
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
