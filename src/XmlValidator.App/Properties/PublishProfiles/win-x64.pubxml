<?xml version="1.0" encoding="utf-8"?>
<!--
  Objavljivanje za win-x64: jedan izvršni fajl sa ugrađenim .NET okruženjem (ne traži instaliran .NET).
  Pokretanje:  dotnet publish src/XmlValidator.App -p:PublishProfile=win-x64
  Rezultat:    artifacts/publish/win-x64/
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      Nativne biblioteke (Skia, HarfBuzz, ANGLE) idu u izvršni fajl i raspakuju se pri prvom pokretanju.
      Sklopovi su komprimovani (manji fajl, neznatno sporije prvo pokretanje).
      Bez trimovanja: AvaloniaEdit, DataGrid i XAML učitavanje nisu pouzdani pri trimovanju.
      Simboli su ugrađeni u sklopove (Directory.Build.props), a .pdb fajlovi nativnih paketa se ne objavljuju (.csproj).
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
