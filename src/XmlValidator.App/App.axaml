<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XmlValidator.App.App"
             Name="XML Validator"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://XmlValidator/Styles/Tokens.axaml" />
                <ResourceInclude Source="avares://XmlValidator/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Akcentna boja je fiksna (ista na svakom računaru), da bi paleta ostala dosljedna. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="{StaticResource AccentColorLight}" />
                <ColorPaletteResources x:Key="Dark" Accent="{StaticResource AccentColorDark}" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://XmlValidator/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
