<!--
  Stilovi kontrola po klasama. Redoslijed je bitan: u Avaloniji kasniji stil pobjeđuje,
  pa osnovni stilovi idu prvi, a klase (primary, danger, toolbar...) poslije njih.

  Klase:
    Button: (osnovno = sekundarno), primary, danger, toolbar, link, icon
    DropDownButton: toolbar
    Border: card, settingRow, toolbar, statusbar, banner (+ info/success/warning/error),
            badge (+ accent/neutral/warning), heroIcon, dropOverlay, footer, divider
    TextBlock/SelectableTextBlock: display, title, subtitle, strong, muted, caption, mono, accent
    PathIcon: small, large, hero, status (+ info/success/warning/error), accent, muted
    ListBox: nav, list
    TabControl: main (+ StackPanel.tabHeader u zaglavlju taba, Border.attentionLine: trepćuća linija)
    Tab „Validacija”: Border.pane/paneHeader, Border.toolbar.tabbar, Border.banner.compact,
            Border.badge (+ accentSubtle/error), TextBlock.summary (+ ozbiljnost), TextBlock.warningText,
            Border.toast (+ success: plutajuće obavještenje sa sjenkom),
            ComboBox.field, GridSplitter.pane, DataGrid.issues (+ TextBlock.cell/number/message/fullMessage), ToolTip.wide,
            StackPanel.emptyPane, ProgressBar.busySmall, Button.toolbar.compact,
            ae|TextEditor.xml, ui|IssueMarkerMargin
    Tab „Čišćenje faktura”: ToggleButton.toolbar (+ chevron), Border.settingsPanel, Border.stats/stat (+ last/attention/error),
            TextBlock.statLabel/statValue (+ Border.stat.optional i TextBlock.statLabel.long/short za uzak prozor), DataGrid.invoices (+ ComboBox.cellAction/.unresolved, Border.partBadge),
            ListBox.notes (+ TextBlock.noteText), Border.pane.editing, Border.savebar (+ TextBlock.reason),
            TextBox.search, TextBlock.errorText, ProgressBar.analysis, GridSplitter.paneColumns,
            Button.icon.small, Border.banner TextBlock.message, ui|FileLineNumberMargin
    Faza 6: RadioButton.segment (uz Theme ToggleButton), Border.badge (+ info/success), Border.windowHeader,
            Border.keyCap, Border.listRow, ProgressBar.download
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:aee="using:AvaloniaEdit.Editing"
        xmlns:ui="using:XmlValidator.App.Controls">

    <Design.PreviewWith>
        <Border Padding="24">
            <StackPanel Spacing="8">
                <Button Classes="primary" Content="Primarno" />
                <Button Content="Sekundarno" />
                <Button Classes="danger" Content="Obriši" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ========== Osnova ========== -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <!-- ========== Tekst ========== -->

    <Style Selector=":is(TextBlock).display">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).subtitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).strong">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>
    <Style Selector=":is(TextBlock).mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
    </Style>
    <Style Selector=":is(TextBlock).accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).wrap">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ========== Ikonice ========== -->

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="{DynamicResource IconSizeM}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeM}" />
    </Style>
    <Style Selector="PathIcon.small">
        <Setter Property="Width" Value="{DynamicResource IconSizeS}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeS}" />
    </Style>
    <Style Selector="PathIcon.large">
        <Setter Property="Width" Value="{DynamicResource IconSizeL}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeL}" />
    </Style>
    <Style Selector="PathIcon.xl">
        <Setter Property="Width" Value="{DynamicResource IconSizeXl}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeXl}" />
    </Style>
    <Style Selector="PathIcon.hero">
        <Setter Property="Width" Value="{DynamicResource IconSizeHero}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeHero}" />
    </Style>
    <Style Selector="PathIcon.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="PathIcon.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Statusne ikonice: oblik i boja po ozbiljnosti (oblik nosi značenje i bez boje) -->
    <Style Selector="PathIcon.status.info">
        <Setter Property="Data" Value="{DynamicResource IconInfo}" />
        <Setter Property="Foreground" Value="{DynamicResource InfoForegroundBrush}" />
    </Style>
    <Style Selector="PathIcon.status.success">
        <Setter Property="Data" Value="{DynamicResource IconSuccess}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
    </Style>
    <Style Selector="PathIcon.status.warning">
        <Setter Property="Data" Value="{DynamicResource IconWarning}" />
        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>
    <Style Selector="PathIcon.status.error">
        <Setter Property="Data" Value="{DynamicResource IconError}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>

    <!-- ========== Dugmad ========== -->

    <!-- Osnovno (sekundarno) dugme -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Primarno: glavna akcija na ekranu -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Opasno: brisanje, prepisivanje (uvijek uz potvrdu) -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Opasno, ali tiše (u listi akcija): crveni tekst, bez punjenja -->
    <Style Selector="Button.dangerOutline">
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.dangerOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.dangerOutline:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBorderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>

    <!-- Dugme u traci sa komandama: bez okvira, ikonica + tekst -->
    <Style Selector="Button.toolbar, DropDownButton.toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ToolbarButtonPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
    <Style Selector="Button.toolbar:disabled PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Dugme kao link (sekundarna navigacija, npr. „Upravljaj šemama”) -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ThicknessXs}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBorderBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Malo dugme samo sa ikonicom (zatvaranje poruke, panela) -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ThicknessS}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ========== Površine ========== -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
    </Style>

    <!-- Red podešavanja: opis lijevo, kontrola desno -->
    <Style Selector="Border.settingRow">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="Padding" Value="{DynamicResource ThicknessL}" />
    </Style>

    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Padding" Value="{DynamicResource ToolbarPadding}" />
    </Style>

    <Style Selector="Border.statusbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerTop}" />
        <Setter Property="Padding" Value="{DynamicResource StatusBarPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    </Style>

    <Style Selector="Border.footer">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerTop}" />
        <Setter Property="Padding" Value="{DynamicResource DialogFooterPadding}" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="{DynamicResource ThicknessXs}" />
    </Style>

    <!-- Okvir velike ikonice praznog stanja -->
    <Style Selector="Border.heroIcon">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Width" Value="{DynamicResource HeroFrameSize}" />
        <Setter Property="Height" Value="{DynamicResource HeroFrameSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusHero}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.heroIcon > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Width" Value="{DynamicResource IconSizeHero}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeHero}" />
    </Style>

    <!-- Nagovještaj tokom prevlačenja fajla -->
    <Style Selector="Border.dropOverlay">
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource FocusThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="Margin" Value="{DynamicResource ThicknessM}" />
    </Style>

    <!-- ========== Poruke (banner) po ozbiljnosti ========== -->

    <Style Selector="Border.banner">
        <Setter Property="Padding" Value="{DynamicResource BannerPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
    </Style>
    <Style Selector="Border.banner.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
    </Style>
    <Style Selector="Border.banner.warning">
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    </Style>
    <Style Selector="Border.banner.error">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
    </Style>

    <!-- ========== Oznake (badge) ========== -->

    <Style Selector="Border.badge">
        <Setter Property="Padding" Value="{DynamicResource BadgePadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralForegroundBrush}" />
    </Style>
    <Style Selector="Border.badge.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.badge.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Border.badge.warning">
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge.warning TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>

    <!-- ========== Tabovi glavnog prozora ========== -->

    <!--
      Tabovi kao „kartice”: traka tabova je na površini (kao traka sa komandama) i odvojena je od
      sadržaja linijom. Neizabran tab je zaobljena siva kartica; izabran tab je na boji površine, sa
      okvirom, akcentnom trakom na vrhu, i prekriva liniju ispod sebe, pa se spaja sa sadržajem
      (traka taba ispod je takođe na površini). Traka tabova se crta iznad sadržaja (ZIndex) da bi
      izabran tab mogao da prekrije liniju.
    -->
    <Style Selector="TabControl.main">
        <Setter Property="Padding" Value="{DynamicResource NoThickness}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="TabControl.main /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="{DynamicResource TabStripPadding}" />
        <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="TabControl.main /template/ ContentPresenter#PART_SelectedContentHost">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerTop}" />
    </Style>
    <Style Selector="TabControl.main TabItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{DynamicResource TabHeaderHeight}" />
        <Setter Property="Margin" Value="{DynamicResource TabItemMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TabControl.main TabItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TabBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TabCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource NoThickness}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TabControl.main TabItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="{DynamicResource TabHeaderPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TabControl.main TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TabControl.main TabItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TabControl.main TabItem:selected">
        <Setter Property="Margin" Value="{DynamicResource TabItemSelectedMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TabControl.main TabItem:selected /template/ Border#PART_LayoutRoot, TabControl.main TabItem:selected:pointerover /template/ Border#PART_LayoutRoot, TabControl.main TabItem:selected:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- Ikonica u zaglavlju izabranog taba (StackPanel.tabHeader) je u akcentnoj boji -->
    <Style Selector="TabControl.main TabItem:selected StackPanel.tabHeader > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <!-- Akcentna traka izabranog taba: preko gornje ivice, cijelom širinom taba -->
    <Style Selector="TabControl.main TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{DynamicResource TabIndicatorHeight}" />
        <Setter Property="Margin" Value="{DynamicResource TabIndicatorMargin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TabIndicatorCornerRadius}" />
    </Style>
    <!-- Fokus sa tastature: akcentni okvir i blaga akcentna pozadina -->
    <Style Selector="TabControl.main TabItem:focus-visible /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TabControl.main TabItem:focus-visible:not(:selected) /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>

    <!-- Trepćuća linija ispod teksta taba (npr. „Čišćenje faktura” kad fajl ima faktura za čišćenje).
         Negativna donja margina je spušta ispod teksta bez uticaja na raspored zaglavlja, pa se tab
         ne pomjera kad se linija pojavi ili nestane. Značenje nosi i opis alata (ne samo boja). -->
    <Style Selector="Border.attentionLine">
        <Setter Property="Background" Value="{DynamicResource AttentionBrush}" />
        <Setter Property="Height" Value="{DynamicResource AttentionLineHeight}" />
        <Setter Property="Margin" Value="{DynamicResource AttentionLineMargin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Style.Animations>
            <!-- Mirno treptanje: 0,6 s u jednom smjeru, pa nazad -->
            <Animation Duration="0:0:0.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.2" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ========== Liste ========== -->

    <!-- Navigacija u Podešavanjima -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ThicknessS}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource ListItemPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="Margin" Value="{DynamicResource ThicknessXs}" />
    </Style>

    <!-- Lista sa karticama stavki (npr. šeme) -->
    <Style Selector="ListBox.list">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="Padding" Value="{DynamicResource ThicknessXs}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource ListItemPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    </Style>

    <!-- Zajedničko za obje liste: izbor u akcentnoj boji -->
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.list ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- ========== Indikator rada ========== -->

    <Style Selector="ProgressBar.busy">
        <Setter Property="Width" Value="{DynamicResource BusyBarWidth}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{DynamicResource BusyBarHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

<!-- ========== Tab „Validacija” ========== -->

    <!-- Traka taba: površina sa donjom linijom -->
    <Style Selector="Border.toolbar.tabbar">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerBottom}" />
        <Setter Property="Padding" Value="{DynamicResource PaneHeaderPadding}" />
    </Style>

    <!-- Sažetak rezultata: boja prati ozbiljnost, a ikonica i tekst nose značenje.
         Duži tekst se prelama u najviše dva reda. -->
    <Style Selector="TextBlock.summary">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="{DynamicResource SummaryMaxLines}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.summary.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.summary.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.summary.warning">
        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.warningText">
        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>

    <Style Selector="ComboBox.field">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Plutajuće obavještenje (toast) na sredini taba: zaobljena kartica sa sjenkom -->
    <Style Selector="Border.toast">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource ToastMargin}" />
        <Setter Property="Padding" Value="{DynamicResource ToastPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ToastShadow}" />
    </Style>
    <Style Selector="Border.toast.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
    </Style>
    <Style Selector="Border.toast.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
    </Style>

    <Style Selector="Border.banner.compact">
        <Setter Property="Padding" Value="{DynamicResource BannerCompactPadding}" />
    </Style>

    <Style Selector="ProgressBar.busySmall">
        <Setter Property="Width" Value="{DynamicResource IconSizeL}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{DynamicResource BusyBarHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.toolbar.compact">
        <Setter Property="Padding" Value="{DynamicResource ToolbarCompactButtonPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
    </Style>

    <!-- Panel (editor, lista nalaza): kartica bez unutrašnjeg razmaka, sa zaglavljem -->
    <Style Selector="Border.pane">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.paneHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerBottom}" />
        <Setter Property="Padding" Value="{DynamicResource ToolbarPadding}" />
    </Style>

    <Style Selector="Border.badge.accentSubtle">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.badge.accentSubtle TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Border.badge.error">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge.error TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>
    <Style Selector="Border.badge PathIcon">
        <Setter Property="Width" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Height" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Pomična granica između editora i liste: razmak između panela, kursor za promjenu visine -->
    <Style Selector="GridSplitter.pane">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource PaneSplitterSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource PaneSplitterSize}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="GridSplitter.pane:pointerover, GridSplitter.pane:focus-visible">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>

    <!-- Lista nalaza -->
    <Style Selector="DataGrid.issues">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="RowBackground" Value="Transparent" />
    </Style>
    <Style Selector="DataGrid.issues DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    </Style>
    <!-- Ćelije u veličini teksta aplikacije (tema DataGrid-a ima veći font) -->
    <Style Selector="DataGrid.issues DataGridCell">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="DataGrid.issues DataGridRow, DataGrid.issues DataGridRow:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="DataGrid.issues StackPanel.cell, DataGrid.issues TextBlock.cell">
        <Setter Property="Margin" Value="{DynamicResource CellPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGrid.issues TextBlock.number">
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
    </Style>
    <Style Selector="DataGrid.issues TextBlock.message">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="{DynamicResource IssueMessageMaxLines}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Cijela poruka nalaza validacije: prelama se u više redova, red tabele raste u visinu -->
    <Style Selector="DataGrid.issues TextBlock.fullMessage">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Širi ToolTip za duže objašnjenje (poruka + tehnički opis) -->
    <Style Selector="ToolTip.wide">
        <Setter Property="MaxWidth" Value="{DynamicResource WideToolTipMaxWidth}" />
    </Style>
    <Style Selector="ToolTip.wide TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Prazno stanje unutar panela -->
    <Style Selector="StackPanel.emptyPane">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="{DynamicResource EmptyStateMaxWidth}" />
        <Setter Property="Spacing" Value="{DynamicResource SpaceS}" />
        <Setter Property="Margin" Value="{DynamicResource ThicknessL}" />
    </Style>

    <!-- Editor XML-a -->
    <Style Selector="ae|TextEditor.xml">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource EditorFontSize}" />
        <Setter Property="LineNumbersForeground" Value="{DynamicResource EditorLineNumberBrush}" />
        <Setter Property="Padding" Value="{DynamicResource EditorPadding}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="ae|TextEditor.xml aee|TextArea">
        <Setter Property="SelectionBrush" Value="{DynamicResource EditorSelectionBrush}" />
    </Style>
    <Style Selector="ui|IssueMarkerMargin">
        <Setter Property="ErrorBrush" Value="{DynamicResource ErrorForegroundBrush}" />
        <Setter Property="WarningBrush" Value="{DynamicResource WarningForegroundBrush}" />
        <Setter Property="ErrorLineBrush" Value="{DynamicResource EditorErrorLineBrush}" />
        <Setter Property="WarningLineBrush" Value="{DynamicResource EditorWarningLineBrush}" />
        <Setter Property="MarkerWidth" Value="{DynamicResource IssueMarginWidth}" />
    </Style>

    <!-- ========== Tab „Čišćenje faktura” ========== -->

    <!-- Preklopno dugme u traci (npr. „Podešavanja analize”): uključeno stanje je blago akcentno -->
    <Style Selector="ToggleButton.toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ToolbarButtonPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolbar:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBorderBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Strelica „Podešavanja analize” uz „Analiziraj”: kvadratno dugme samo sa ikonicom -->
    <Style Selector="ToggleButton.toolbar.chevron">
        <Setter Property="Padding" Value="{DynamicResource ThicknessS}" />
        <Setter Property="MinWidth" Value="{DynamicResource ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Panel podešavanja analize (ispod trake taba, sklopiv) -->
    <Style Selector="Border.settingsPanel">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerBottom}" />
        <Setter Property="Padding" Value="{DynamicResource SettingsPanelPadding}" />
    </Style>
    <Style Selector="Border.settingsPanel NumericUpDown">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Sažetak: traka pločica (oznaka + broj), razdvojenih linijom -->
    <Style Selector="Border.stats">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.stat">
        <Setter Property="Padding" Value="{DynamicResource StatPadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerRight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.stat.last">
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
    </Style>
    <Style Selector="Border.stat.attention">
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    </Style>
    <Style Selector="Border.stat.error">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    </Style>
    <Style Selector="TextBlock.statLabel">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.statLabel.short">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Sažetak na uskom prozoru (širina područja sažetka u traci taba „Čišćenje faktura”):
         prvo zbijene pločice i kraća oznaka, pa se pločice sklanjaju od najmanje važne
         (Ukupno i Popravki, pa Ostaje, pa Kandidata). „Čeka odluku” i „Upozorenja” ostaju uvijek.
         Ukupno, ostaje i kandidata su i u poruci o završenoj analizi i u zaglavlju tabele.
         Pragovi su izmjerene širine pločica (font 12/16) uz malu rezervu. -->
    <ContainerQuery Name="SummaryArea" Query="max-width:524">
        <Style Selector="Border.stat">
            <Setter Property="Padding" Value="{DynamicResource StatCompactPadding}" />
        </Style>
        <Style Selector="TextBlock.statLabel.long">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.statLabel.short">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ContainerQuery>
    <ContainerQuery Name="SummaryArea" Query="max-width:436">
        <Style Selector="Border.stat.hideNarrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ContainerQuery>
    <ContainerQuery Name="SummaryArea" Query="max-width:304">
        <Style Selector="Border.stat.hideNarrower">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ContainerQuery>
    <ContainerQuery Name="SummaryArea" Query="max-width:250">
        <Style Selector="Border.stat.hideNarrowest">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ContainerQuery>

    <Style Selector="Border.stat.attention TextBlock.statValue, Border.stat.attention TextBlock.statLabel">
        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>
    <Style Selector="Border.stat.error TextBlock.statValue, Border.stat.error TextBlock.statLabel">
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>

    <!-- Tabela faktura: osnova je DataGrid.issues, ćelije su zbijenije jer kolona ima više -->
    <Style Selector="DataGrid.invoices">
        <Setter Property="SelectionMode" Value="Extended" />
    </Style>
    <Style Selector="DataGrid.invoices DataGridColumnHeader">
        <Setter Property="Padding" Value="{DynamicResource CompactHeaderPadding}" />
    </Style>
    <Style Selector="DataGrid.invoices StackPanel.cell, DataGrid.invoices TextBlock.cell">
        <Setter Property="Margin" Value="{DynamicResource CompactCellPadding}" />
    </Style>
    <Style Selector="DataGrid.invoices TextBlock.cell">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="DataGrid.invoices TextBlock.right">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="ComboBox.cellAction">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxCompactPadding}" />
        <Setter Property="Margin" Value="{DynamicResource ThicknessXs}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    </Style>
    <!-- Sumnjiv blok bez odluke: crvena ivica i tekst „Izaberite…” (uz ikonicu i tekst u koloni statusa) -->
    <Style Selector="ComboBox.cellAction.unresolved">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource FocusThickness}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>
    <Style Selector="ComboBox.cellAction.unresolved:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>
    <Style Selector="Border.partBadge">
        <Setter Property="Padding" Value="{DynamicResource BadgePadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackgroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.partBadge TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralForegroundBrush}" />
    </Style>

    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="{DynamicResource IconSizeS}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeS}" />
        <Setter Property="Margin" Value="{DynamicResource InlineGapS}" />
    </Style>

    <Style Selector="Button.icon.small">
        <Setter Property="Padding" Value="{DynamicResource ThicknessXs}" />
    </Style>
    <Style Selector="Border.banner TextBlock.message">
        <Setter Property="MaxLines" Value="{DynamicResource SaveReasonMaxLines}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.errorText">
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>

    <!-- Lista popravki i upozorenja -->
    <Style Selector="ListBox.notes">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" />
        <Setter Property="Padding" Value="{DynamicResource NoThickness}" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource NoteItemPadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerBottom}" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedHoveredBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.notes TextBlock.noteText">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="{DynamicResource NoteTextMaxLines}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Panel u kojem se uređuje blok: akcentna ivica da bude jasno da je tekst izmjenjiv -->
    <Style Selector="Border.pane.editing">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource FocusThickness}" />
    </Style>

    <!-- Traka za čuvanje (dno taba) -->
    <Style Selector="Border.savebar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerTop}" />
        <Setter Property="Padding" Value="{DynamicResource SaveBarPadding}" />
    </Style>
    <Style Selector="Border.savebar TextBlock.reason">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="{DynamicResource SaveReasonMaxLines}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Pregled bloka: brojevi linija ulaznog fajla i označena linija -->
    <Style Selector="ui|FileLineNumberMargin">
        <Setter Property="Foreground" Value="{DynamicResource EditorLineNumberBrush}" />
        <Setter Property="HighlightForeground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="HighlightBrush" Value="{DynamicResource EditorHighlightLineBrush}" />
        <Setter Property="Margin" Value="{DynamicResource LineNumberGap}" />
    </Style>

    <Style Selector="ProgressBar.analysis">
        <Setter Property="Width" Value="{DynamicResource ProgressBarWidth}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{DynamicResource BusyBarHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Uspravna pomična granica (pregled bloka | lista popravki) -->
    <Style Selector="GridSplitter.paneColumns">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{DynamicResource PaneSplitterSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource PaneSplitterSize}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="GridSplitter.paneColumns:pointerover, GridSplitter.paneColumns:focus-visible">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>

    <!-- ========== Faza 6: pregled izmjena, „O programu”, preuzimanje šeme ========== -->

    <!-- Segmentni izbor (filter): RadioButton sa izgledom preklopnog dugmeta (Theme u XAML-u je ToggleButton) -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="{DynamicResource SegmentPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBorderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Oznaka vrste izmjene / ozbiljnosti u ćeliji: ikonica + tekst u boji statusa -->
    <Style Selector="Border.badge.info">
        <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge.info TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InfoForegroundBrush}" />
    </Style>
    <Style Selector="Border.badge.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
    </Style>
    <Style Selector="Border.badge.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
    </Style>

    <!-- Zaglavlje prozora (naslov, opis) i tijelo sa bočnim razmakom -->
    <Style Selector="Border.windowHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerBottom}" />
        <Setter Property="Padding" Value="{DynamicResource HeaderPadding}" />
    </Style>

    <!-- Taster na tastaturi (prečice u „O programu”) -->
    <Style Selector="Border.keyCap">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
        <Setter Property="Padding" Value="{DynamicResource KeyCapPadding}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keyCap TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Red u listi (prečice, biblioteke): donja linija između redova -->
    <Style Selector="Border.listRow">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DividerBottom}" />
        <Setter Property="Padding" Value="{DynamicResource NoteItemPadding}" />
    </Style>

    <!-- Kartica preuzimanja šeme (napredak + Prekini) -->
    <Style Selector="ProgressBar.download">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{DynamicResource BusyBarHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Glavni prozor: tab sa prečicom u opisu -->
    <Style Selector="TabControl.main TabItem:focus-visible">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TabControl.main TabItem:focus-visible StackPanel.tabHeader > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

</Styles>
