<!--
  Dizajn tokeni: boje (svijetla i tamna tema), razmaci, radijusi, fontovi i veličine.
  U prozorima i kontrolama se koriste samo ovi resursi (DynamicResource/StaticResource) i
  klase stilova iz Controls.axaml, nikad ručno upisane boje i veličine.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Akcentna boja po temi; koristi je i Fluent paleta (App.axaml) za fokus, izbor i kontrole. -->
    <Color x:Key="AccentColorLight">#0F62B8</Color>
    <Color x:Key="AccentColorDark">#5AA6F0</Color>

    <ResourceDictionary.ThemeDictionaries>

        <!-- Svijetla tema -->
        <ResourceDictionary x:Key="Light">
            <!-- Površine -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFBFC" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EBEDF0" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E1E4E8" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E1E4E8" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#DDE1E6" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#F2F3F4F6" />

            <!-- Tekst -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F24" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#545D69" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA1AA" />

            <!-- Akcentna boja (jedna, za glavnu akciju, izbor i fokus) -->
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#0D56A3" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B4A8C" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#0F5BAA" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E3EEFA" />
            <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#B9D3F0" />

            <!-- Opasne akcije -->
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#AE2618" />
            <SolidColorBrush x:Key="DangerPressedBrush" Color="#962014" />
            <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#B3261A" />

            <!-- Statusi: tekst/ikonica, pozadina, ivica -->
            <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#B3261A" />
            <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDECEC" />
            <SolidColorBrush x:Key="ErrorBorderBrush" Color="#F3C2BE" />
            <SolidColorBrush x:Key="WarningForegroundBrush" Color="#8A5300" />
            <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF5D9" />
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#F0D899" />
            <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#0E6E2E" />
            <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#E4F5E8" />
            <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B5DFC0" />
            <SolidColorBrush x:Key="InfoForegroundBrush" Color="#0F5BAA" />
            <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#E8F1FB" />
            <SolidColorBrush x:Key="InfoBorderBrush" Color="#BCD5F0" />

            <!-- Oznake (badge) -->
            <SolidColorBrush x:Key="BadgeNeutralBackgroundBrush" Color="#EBEDF0" />
            <SolidColorBrush x:Key="BadgeNeutralForegroundBrush" Color="#3D4550" />
            <!-- Neizabran tab glavnog prozora: siva kartica na površini -->
            <SolidColorBrush x:Key="TabBackgroundBrush" Color="#F0F1F3" />
            <SolidColorBrush x:Key="TabBorderBrush" Color="#E4E7EB" />
            <!-- Editor XML-a: izbor, oznake linija sa nalazima, bojenje sintakse -->
            <SolidColorBrush x:Key="EditorSelectionBrush" Color="#C7DDF5" />
            <!-- Brojevi linija: najmanje 4.5:1 prema površini (WCAG AA) -->
            <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#6B737D" />
            <SolidColorBrush x:Key="EditorErrorLineBrush" Color="#16C42B1C" />
            <SolidColorBrush x:Key="EditorWarningLineBrush" Color="#1FD99A00" />
            <SolidColorBrush x:Key="EditorHighlightLineBrush" Color="#260F62B8" />
            <SolidColorBrush x:Key="SyntaxTagBrush" Color="#1A5BA6" />
            <SolidColorBrush x:Key="SyntaxAttributeNameBrush" Color="#9A3A12" />
            <SolidColorBrush x:Key="SyntaxAttributeValueBrush" Color="#0E7040" />
            <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#6A737D" />
            <SolidColorBrush x:Key="SyntaxDeclarationBrush" Color="#7A3E9D" />
            <SolidColorBrush x:Key="SyntaxEntityBrush" Color="#9A5B00" />

            <!-- Izabran red u tabelama (DataGrid): blaga akcentna pozadina, tekst ostaje čitljiv -->
            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#D9E7F8" />
            <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#CCE0F6" />
            <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#E4EDF8" />
            <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#D9E7F8" />
        </ResourceDictionary>

        <!-- Tamna tema -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#18191C" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#232529" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1E2023" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2E3136" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#373A40" />
            <SolidColorBrush x:Key="DividerBrush" Color="#33363C" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#373A40" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#F218191C" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF1" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B0BA" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#6B7179" />

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColorDark}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#73B4F3" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A93DB" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#0A1A2C" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#7DB9F4" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3249" />
            <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#2F4D6E" />

            <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#EC6B64" />
            <SolidColorBrush x:Key="DangerPressedBrush" Color="#DB4E46" />
            <SolidColorBrush x:Key="OnDangerBrush" Color="#1C0807" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8A82" />

            <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FF8A82" />
            <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#3A2224" />
            <SolidColorBrush x:Key="ErrorBorderBrush" Color="#5C3134" />
            <SolidColorBrush x:Key="WarningForegroundBrush" Color="#F2C14E" />
            <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#382F1A" />
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#5A4A22" />
            <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#6FD08C" />
            <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#1F3326" />
            <SolidColorBrush x:Key="SuccessBorderBrush" Color="#2E5039" />
            <SolidColorBrush x:Key="InfoForegroundBrush" Color="#7DB9F4" />
            <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#1D2B3B" />
            <SolidColorBrush x:Key="InfoBorderBrush" Color="#2D4560" />

            <SolidColorBrush x:Key="BadgeNeutralBackgroundBrush" Color="#33363C" />
            <SolidColorBrush x:Key="BadgeNeutralForegroundBrush" Color="#D3D7DD" />
            <SolidColorBrush x:Key="TabBackgroundBrush" Color="#1B1D20" />
            <SolidColorBrush x:Key="TabBorderBrush" Color="#2C2F34" />
            <SolidColorBrush x:Key="EditorSelectionBrush" Color="#2B4A6E" />
            <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#8E959F" />
            <SolidColorBrush x:Key="EditorErrorLineBrush" Color="#26FF6B61" />
            <SolidColorBrush x:Key="EditorWarningLineBrush" Color="#1FF2C14E" />
            <SolidColorBrush x:Key="EditorHighlightLineBrush" Color="#335AA6F0" />
            <SolidColorBrush x:Key="SyntaxTagBrush" Color="#6CB2F5" />
            <SolidColorBrush x:Key="SyntaxAttributeNameBrush" Color="#F0A47E" />
            <SolidColorBrush x:Key="SyntaxAttributeValueBrush" Color="#86D6A6" />
            <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#8B949E" />
            <SolidColorBrush x:Key="SyntaxDeclarationBrush" Color="#C9A0EC" />
            <SolidColorBrush x:Key="SyntaxEntityBrush" Color="#E5C07B" />

            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#24405F" />
            <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#2B4A6E" />
            <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#2A3644" />
            <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#2F3D4D" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Skala razmaka: 4, 8, 12, 16, 24, 32 -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>

    <Thickness x:Key="ThicknessXs">4</Thickness>
    <Thickness x:Key="ThicknessS">8</Thickness>
    <Thickness x:Key="ThicknessM">12</Thickness>
    <Thickness x:Key="ThicknessL">16</Thickness>
    <Thickness x:Key="ThicknessXl">24</Thickness>
    <Thickness x:Key="ThicknessXxl">32</Thickness>

    <!-- Složeni razmaci (izvedeni iz skale) -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">24,20</Thickness>
    <Thickness x:Key="ToolbarPadding">12,8</Thickness>
    <Thickness x:Key="StatusBarPadding">16,4</Thickness>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>
    <Thickness x:Key="ToolbarButtonPadding">12,8</Thickness>
    <Thickness x:Key="ToolbarCompactButtonPadding">8,4</Thickness>
    <Thickness x:Key="BannerCompactPadding">12,8</Thickness>
    <!-- Tabovi glavnog prozora (kartice) -->
    <Thickness x:Key="TabHeaderPadding">16,0</Thickness>
    <Thickness x:Key="TabStripPadding">12,6,12,0</Thickness>
    <Thickness x:Key="TabItemMargin">0,0,4,0</Thickness>
    <!-- Izabran tab se spušta za debljinu linije i prekriva je (spaja se sa sadržajem) -->
    <Thickness x:Key="TabItemSelectedMargin">0,0,4,-1</Thickness>
    <Thickness x:Key="TabBorderThickness">1,1,1,0</Thickness>
    <Thickness x:Key="TabIndicatorMargin">-1,-1,-1,0</Thickness>
    <Thickness x:Key="BannerPadding">16,12</Thickness>
    <Thickness x:Key="BadgePadding">8,2</Thickness>
    <Thickness x:Key="ListItemPadding">12,10</Thickness>
    <Thickness x:Key="DialogPadding">24,24,24,20</Thickness>
    <Thickness x:Key="DialogFooterPadding">24,16</Thickness>
    <Thickness x:Key="SectionGap">0,24,0,0</Thickness>
    <Thickness x:Key="SectionTitleGap">0,0,0,8</Thickness>
    <Thickness x:Key="LabelGap">0,0,0,4</Thickness>
    <Thickness x:Key="StackGapS">0,8,0,0</Thickness>
    <Thickness x:Key="StackGapM">0,12,0,0</Thickness>
    <Thickness x:Key="StackGapL">0,16,0,0</Thickness>
    <Thickness x:Key="InlineGapS">8,0,0,0</Thickness>
    <Thickness x:Key="InlineGapM">12,0,0,0</Thickness>
    <Thickness x:Key="InlineGapL">16,0,0,0</Thickness>
    <Thickness x:Key="DividerThickness">1</Thickness>
    <Thickness x:Key="DividerTop">0,1,0,0</Thickness>
    <Thickness x:Key="DividerBottom">0,0,0,1</Thickness>
    <Thickness x:Key="DividerRight">0,0,1,0</Thickness>
    <Thickness x:Key="DividerLeft">1,0,0,0</Thickness>
    <Thickness x:Key="FocusThickness">2</Thickness>
    <Thickness x:Key="NoThickness">0</Thickness>
    <Thickness x:Key="PaneHeaderPadding">16,10</Thickness>
    <Thickness x:Key="CellPadding">12,6</Thickness>
    <Thickness x:Key="BottomGapM">0,0,0,12</Thickness>
    <Thickness x:Key="EditorPadding">0,4,0,0</Thickness>

    <!-- Radijusi uglova -->
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">6</CornerRadius>
    <CornerRadius x:Key="RadiusL">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">10</CornerRadius>
    <CornerRadius x:Key="RadiusHero">40</CornerRadius>
    <CornerRadius x:Key="TabCornerRadius">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="TabIndicatorCornerRadius">8,8,0,0</CornerRadius>

    <!-- Fontovi -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeDisplay">24</x:Double>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
    <x:Double x:Key="EditorFontSize">13</x:Double>

    <!-- Veličine ikonica -->
    <x:Double x:Key="IconSizeS">14</x:Double>
    <x:Double x:Key="IconSizeM">16</x:Double>
    <x:Double x:Key="IconSizeL">20</x:Double>
    <x:Double x:Key="IconSizeXl">32</x:Double>
    <x:Double x:Key="IconSizeHero">40</x:Double>
    <x:Double x:Key="HeroFrameSize">80</x:Double>

    <!-- Veličine elemenata -->
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="ControlHeightCompact">28</x:Double>
    <x:Double x:Key="TabHeaderHeight">38</x:Double>
    <x:Double x:Key="TabIndicatorHeight">3</x:Double>
    <x:Double x:Key="FieldWidth">220</x:Double>
    <x:Double x:Key="NumericFieldWidth">160</x:Double>
    <x:Double x:Key="ContentMaxWidth">760</x:Double>
    <x:Double x:Key="EmptyStateMaxWidth">460</x:Double>
    <x:Double x:Key="RecentMenuMaxWidth">520</x:Double>
    <x:Double x:Key="DiffPanelHeight">280</x:Double>
    <x:Double x:Key="ListMinHeight">72</x:Double>
    <x:Double x:Key="ListMaxHeight">320</x:Double>
    <x:Double x:Key="DetailsMaxHeight">200</x:Double>
    <x:Double x:Key="OptionsMaxHeight">220</x:Double>
    <x:Double x:Key="BusyBarWidth">120</x:Double>
    <x:Double x:Key="BusyBarHeight">4</x:Double>
    <GridLength x:Key="SettingsNavWidth">184</GridLength>
    <x:Double x:Key="SchemaPickerWidth">240</x:Double>
    <x:Double x:Key="IssueMarginWidth">18</x:Double>
    <x:Double x:Key="EditorPaneMinHeight">140</x:Double>
    <x:Double x:Key="IssuesPaneMinHeight">120</x:Double>
    <x:Double x:Key="PaneSplitterSize">12</x:Double>
    <DataGridLength x:Key="IssueSeverityColumnWidth">132</DataGridLength>
    <DataGridLength x:Key="IssueNumberColumnWidth">84</DataGridLength>
    <DataGridLength x:Key="IssueKindColumnWidth">150</DataGridLength>
    <x:Int32 x:Key="IssueMessageMaxLines">2</x:Int32>
    <!-- ToolTip sa dužim objašnjenjem (nalaz validacije + tehnički opis); Fluent podrazumijeva 320 -->
    <x:Double x:Key="WideToolTipMaxWidth">480</x:Double>
    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
    <!-- Odnos editora i liste nalaza (podrazumijevano 60/40) -->
    <GridLength x:Key="EditorPaneHeight">60*</GridLength>
    <GridLength x:Key="IssuesPaneHeight">40*</GridLength>
    <!-- Detalji izabranog nalaza: kolona desno od tabele nalaza -->
    <x:Double x:Key="IssueDetailsWidth">320</x:Double>
    <Thickness x:Key="IssueDetailsPadding">16,12,16,8</Thickness>
    <Thickness x:Key="IssueDetailsButtonMargin">8,0,8,8</Thickness>
    <x:Int32 x:Key="SummaryMaxLines">2</x:Int32>

    <!-- Tab „Čišćenje faktura” -->
    <Thickness x:Key="CompactCellPadding">8,4</Thickness>
    <Thickness x:Key="CompactHeaderPadding">8,0,4,0</Thickness>
    <Thickness x:Key="StatPadding">12,2</Thickness>
    <Thickness x:Key="ComboBoxCompactPadding">8,2,0,2</Thickness>
    <Thickness x:Key="SettingsPanelPadding">16,12</Thickness>
    <Thickness x:Key="NoteItemPadding">12,8</Thickness>
    <Thickness x:Key="SaveBarPadding">16,10</Thickness>
    <Thickness x:Key="LineNumberGap">8,0,12,0</Thickness>
    <x:Double x:Key="SearchFieldWidth">200</x:Double>
    <x:Double x:Key="FilterFieldWidth">150</x:Double>
    <x:Double x:Key="ActionFieldWidth">140</x:Double>
    <x:Double x:Key="ProgressBarWidth">180</x:Double>
    <x:Double x:Key="CompactCheckHeight">24</x:Double>
    <x:Double x:Key="InvoicesPaneMinHeight">120</x:Double>
    <x:Double x:Key="DetailPaneMinHeight">112</x:Double>
    <x:Double x:Key="PreviewPaneMinWidth">320</x:Double>
    <x:Double x:Key="NotesPaneMinWidth">240</x:Double>
    <x:Double x:Key="SaveReasonMaxWidth">640</x:Double>
    <x:Int32 x:Key="SaveReasonMaxLines">2</x:Int32>
    <x:Int32 x:Key="NoteTextMaxLines">2</x:Int32>
    <GridLength x:Key="InvoicesPaneHeight">62*</GridLength>
    <GridLength x:Key="DetailPaneHeight">38*</GridLength>
    <!-- Dok se blok uređuje, editor dobija više prostora -->
    <GridLength x:Key="EditingInvoicesPaneHeight">42*</GridLength>
    <GridLength x:Key="EditingDetailPaneHeight">58*</GridLength>
    <GridLength x:Key="PreviewPaneWidth">3*</GridLength>
    <GridLength x:Key="NotesPaneWidth">2*</GridLength>
    <DataGridLength x:Key="InvoiceStatusColumnWidth">116</DataGridLength>
    <DataGridLength x:Key="InvoiceNumberColumnWidth">160</DataGridLength>
    <DataGridLength x:Key="InvoiceDateColumnWidth">100</DataGridLength>
    <DataGridLength x:Key="InvoiceJmbColumnWidth">136</DataGridLength>
    <DataGridLength x:Key="InvoiceGroupsColumnWidth">84</DataGridLength>
    <DataGridLength x:Key="InvoiceItemsColumnWidth">100</DataGridLength>
    <DataGridLength x:Key="InvoiceLineColumnWidth">80</DataGridLength>
    <DataGridLength x:Key="InvoiceCategoryColumnWidth">1*</DataGridLength>
    <DataGridLength x:Key="InvoiceReasonColumnWidth">2*</DataGridLength>
    <DataGridLength x:Key="InvoiceActionColumnWidth">128</DataGridLength>
    <x:Double x:Key="InvoiceStarColumnMinWidth">64</x:Double>
    <x:Double x:Key="InvoiceStatusColumnMinWidth">116</x:Double>
    <x:Double x:Key="InvoiceNumberColumnMinWidth">160</x:Double>
    <x:Double x:Key="InvoiceDateColumnMinWidth">100</x:Double>
    <x:Double x:Key="InvoiceJmbColumnMinWidth">136</x:Double>
    <x:Double x:Key="InvoiceGroupsColumnMinWidth">84</x:Double>
    <x:Double x:Key="InvoiceItemsColumnMinWidth">100</x:Double>
    <x:Double x:Key="InvoiceLineColumnMinWidth">80</x:Double>
    <x:Double x:Key="InvoiceActionColumnMinWidth">128</x:Double>

    <!-- Veličine prozora -->
    <x:Double x:Key="MainWindowWidth">1200</x:Double>
    <x:Double x:Key="MainWindowHeight">780</x:Double>
    <x:Double x:Key="MainWindowMinWidth">960</x:Double>
    <x:Double x:Key="MainWindowMinHeight">640</x:Double>
    <x:Double x:Key="SettingsWindowWidth">940</x:Double>
    <x:Double x:Key="SettingsWindowHeight">640</x:Double>
    <x:Double x:Key="SettingsWindowMinWidth">760</x:Double>
    <x:Double x:Key="SettingsWindowMinHeight">520</x:Double>
    <x:Double x:Key="DialogMinWidth">400</x:Double>
    <x:Double x:Key="DialogWidth">480</x:Double>
    <x:Double x:Key="DialogMaxWidth">560</x:Double>

    <!-- Prozor „Pregled izmjena” -->
    <x:Double x:Key="ChangesWindowWidth">1040</x:Double>
    <x:Double x:Key="ChangesWindowHeight">700</x:Double>
    <x:Double x:Key="ChangesWindowMinWidth">760</x:Double>
    <x:Double x:Key="ChangesWindowMinHeight">520</x:Double>
    <GridLength x:Key="ChangesListPaneHeight">40*</GridLength>
    <GridLength x:Key="ChangesDetailPaneHeight">60*</GridLength>
    <x:Double x:Key="ChangesListPaneMinHeight">120</x:Double>
    <x:Double x:Key="ChangesDetailPaneMinHeight">140</x:Double>
    <x:Double x:Key="ChangesTextPaneMinWidth">240</x:Double>
    <DataGridLength x:Key="ChangeKindColumnWidth">196</DataGridLength>
    <x:Double x:Key="ChangeKindColumnMinWidth">196</x:Double>
    <Thickness x:Key="SegmentPadding">12,4</Thickness>
    <Thickness x:Key="HeaderPadding">24,20,24,16</Thickness>
    <Thickness x:Key="BodyPadding">24,0,24,16</Thickness>

    <!-- Prozor „O programu” -->
    <x:Double x:Key="AboutWindowWidth">760</x:Double>
    <x:Double x:Key="AboutWindowHeight">660</x:Double>
    <x:Double x:Key="AboutWindowMinWidth">600</x:Double>
    <x:Double x:Key="AboutWindowMinHeight">480</x:Double>
    <x:Double x:Key="AppIconSize">48</x:Double>
    <Thickness x:Key="KeyCapPadding">6,1</Thickness>
    <x:Double x:Key="ShortcutKeysWidth">132</x:Double>
    <GridLength x:Key="ComponentNameWidth">220</GridLength>
    <x:Double x:Key="ProgressPercentWidth">44</x:Double>

</ResourceDictionary>
